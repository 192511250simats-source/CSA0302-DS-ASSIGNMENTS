#include <stdio.h>

int main()
{
    int n, i;

    printf("Enter number of elements: ");
    scanf("%d", &n);

    int arr[n];

    printf("Enter %d elements:\n", n);
    for(i = 0; i < n; i++)
    {
        scanf("%d", &arr[i]);
    }

    printf("\nUsing Array Indexing:\n");
    for(i = 0; i < n; i++)
    {
        printf("arr[%d] = %d\n", i, arr[i]);
    }

    printf("\nUsing Pointer Notation:\n");
    for(i = 0; i < n; i++)
    {
        printf("*(arr + %d) = %d\n", i, *(arr + i));
    }

    printf("\nAddresses of Array Elements:\n");
    for(i = 0; i < n; i++)
    {
        printf("Address of arr[%d] = %p\n", i, (void *)&arr[i]);
    }

    printf("\nAddress Difference Between Consecutive Elements:\n");
    for(i = 0; i < n - 1; i++)
    {
        printf("arr[%d] to arr[%d] = %ld bytes\n",
               i, i + 1,
               (char *)&arr[i + 1] - (char *)&arr[i]);
    }

    return 0;
}
